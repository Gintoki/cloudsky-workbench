# Web
APP_URL=http://localhost:3000
NODE_ENV=development
DATABASE_URL=postgresql://cloudsky:cloudsky_dev@localhost:5432/cloudsky_workbench
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12

# Demo-only authentication. Must be false in production.
ALLOW_DEMO_AUTH=true

# Python data / AI service
DATA_AI_API_URL=http://localhost:8000
DATA_AI_API_SHARED_SECRET=replace-for-local-development

# Optional providers — intentionally blank until configured.
OPENAI_API_KEY=
OPENAI_MODEL=
WIND_ADAPTER_ENABLED=false
WIND_API_ENDPOINT=
