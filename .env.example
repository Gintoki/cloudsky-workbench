# Web
APP_URL=http://localhost:3000
NODE_ENV=development
DATABASE_URL=postgresql://cloudsky:cloudsky_dev@localhost:5432/cloudsky_workbench
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12

# Demo-only authentication. Must be false in production.
ALLOW_DEMO_AUTH=true

# Python data / AI service
DATA_AI_API_URL=http://localhost:8000
DATA_AI_API_SHARED_SECRET=replace-for-local-development

# Optional providers — intentionally blank until configured.
OPENAI_API_KEY=
OPENAI_MODEL=
WIND_ADAPTER_ENABLED=false
WIND_API_ENDPOINT=

# Research Agent: Alibaba Cloud Model Studio (Bailian). Keep the API key server-side.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_AGENT_MODEL=qwen3.7-plus
AI_AGENT_MAX_REQUESTS_PER_HOUR=20

# Comparable company public end-of-day market data (no API key required)
PUBLIC_MARKET_DATA_CACHE_HOURS=24
