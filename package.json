{
  "name": "cloudsky-capital-strategy-workbench",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern coverage --ignore-pattern playwright-report --ignore-pattern test-results",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file-if-exists=.env --import tsx db/seed.ts",
    "db:import-methodology": "tsx scripts/import-company-research-methodology.ts",
    "db:import-pdf-research": "node --env-file-if-exists=.env --import tsx scripts/import-pdf-company-research.ts",
    "db:import-company-profiles": "node --env-file-if-exists=.env --import tsx scripts/import-company-research-profiles.ts",
    "db:sync-research-market": "node --env-file-if-exists=.env --import tsx scripts/sync-company-research-market-data.ts",
    "db:sync-research-financials": "node --env-file-if-exists=.env --import tsx scripts/sync-company-research-financial-history.ts",
    "db:sync-research-annual-reports": "node --env-file-if-exists=.env --import tsx scripts/sync-company-research-annual-reports.ts",
    "db:import-notion-industry-radar": "node --env-file-if-exists=.env scripts/import-notion-industry-radar-events.mjs",
    "sync:notion": "node scripts/sync-notion-intelligence.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "0.45.2",
    "jose": "^6.1.3",
    "lucide-react": "^0.468.0",
    "next": "^16.2.12",
    "postgres": "^3.4.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.5",
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  },
  "type": "module"
}
